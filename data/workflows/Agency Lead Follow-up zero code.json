      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.Email }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              },
              "rightValue": ""
            },
            {
              "leftValue": "={{ ['new', 'contacted', 'awaiting reply'].includes(($json.Status || '').toLowerCase()) }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": true
            },
            {
              "leftValue": "={{ Number($json['Follow-up Count'] || 0) }}",
              "operator": {
                "type": "number",
                "operation": "lt"
              },
              "rightValue": 3
            },
            {
              "leftValue": "={{ !$json['Follow-up Date'] || $json['Follow-up Date'] <= $now.toFormat('yyyy-MM-dd') }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": true
            },
            {
              "leftValue": "={{ ($json['Last Contact Date'] || '').slice(0, 10) !== $now.toFormat('yyyy-MM-dd') }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": true
            }
          ],
          "combinator": "and"
        },
